---
// 3D 工牌组件
// 修改卡片内容 → 编辑同目录 badge.data.ts
---

<div class='badge-spacer'>
  <p class='badge-hint'></p>
</div>
<div data-badge-stage></div>

<script>
  import { badge } from './badge.data'
  import { initBadge } from './badge3d'

  const stage = document.querySelector<HTMLElement>('[data-badge-stage]')
  const anchor = document.querySelector<HTMLElement>('.badge-spacer')
  if (stage) void initBadge(stage, badge, anchor)
</script>

<style>
  .badge-spacer {
    position: relative;
    height: 560px;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .badge-spacer {
      height: 460px;
    }
  }
  .badge-hint {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground) / 0.6);
  }
</style>
